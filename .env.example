# Telegram bot tokeni (@BotFather'dan oling)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Anthropic Claude API kaliti (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Ishlatiladigan model (ixtiyoriy, standart: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8

# --- To'lov sozlamalari ---
# Mijoz pul o'tkazadigan plastik karta (sizning kartangiz)
PAYMENT_CARD_NUMBER=8600 1234 5678 9012
PAYMENT_CARD_HOLDER=AZIZBEK G.

# Har bir sahifa narxi (so'mda)
PRICE_PER_PAGE=5000

# Sahifa chegaralari (mijoz shu oraliqda tanlaydi)
MIN_PAGES=1
MAX_PAGES=15

# To'lov cheki yuboriladigan admin (egasi) Telegram chat ID si (ixtiyoriy).
# O'z ID ingizni @userinfobot orqali bilib oling.
ADMIN_CHAT_ID=

# --- Webhook veb-serveri (Click/Payme uchun) ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Tashqi ochiq HTTPS manzil (mas. https://bot.example.uz).
# Payme webhook URL: <WEBHOOK_BASE_URL>/payme
# Click Prepare URL: <WEBHOOK_BASE_URL>/click/prepare
# Click Complete URL: <WEBHOOK_BASE_URL>/click/complete
WEBHOOK_BASE_URL=

# --- Payme (Paycom) Merchant API ---
# Bo'sh qoldirsangiz Payme usuli o'chiq bo'ladi.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_ACCOUNT_FIELD=order_id
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# --- Click Merchant API ---
# Bo'sh qoldirsangiz Click usuli o'chiq bo'ladi.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_BASE_URL=https://my.click.uz/services/pay
