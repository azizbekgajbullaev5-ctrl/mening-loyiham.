# ---------------------------------------------------------------- required in production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# set to true when served over HTTPS (recommended)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- limits & privacy
MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=10
# delete the original file right after analysis (results are kept)
DELETE_FILES_AFTER_ANALYSIS=false
# delete stored originals older than N days (0 = keep until the user deletes)
RETENTION_DAYS=0
# optional ClamAV daemon for malware scanning of uploads
CLAMAV_HOST=
CLAMAV_PORT=3310

# ---------------------------------------------------------------- analysis
SUSPICIOUS_THRESHOLD=60
QUICK_MAX_PASSAGES_PER_SECTION=8
# max passages sent to each external provider per document (DEEP only)
EXTERNAL_MAX_PASSAGES=40
OCR_ENABLED=true
OCR_LANGUAGES=uzb+rus+eng
OCR_MAX_PAGES=400

# ---------------------------------------------------------------- optional external providers
# Leave empty to disable. Nothing is ever faked when a provider is not configured.
# Generic AI-detector HTTP API (see docs/providers.md for the JSON contract)
AI_DETECTOR_API_URL=
AI_DETECTOR_API_KEY=
AI_DETECTOR_NAME=External AI detector
AI_DETECTOR_SCORE_FIELD=ai_probability
AI_DETECTOR_SCORE_SCALE=1.0
AI_DETECTOR_RPM=30

# Generic similarity / plagiarism HTTP API
SIMILARITY_API_URL=
SIMILARITY_API_KEY=
SIMILARITY_API_NAME=External similarity service
SIMILARITY_RPM=20

# LLM-assisted stylistic review (experimental, opt-in)
LLM_REVIEW_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_RPM=20
